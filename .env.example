# Proxy del mismo origen en producción. Para desarrollo directo usa:
# NEXT_PUBLIC_HERMES_API_URL=http://localhost:3003/api
NEXT_PUBLIC_HERMES_API_URL=/api/hermes

# API del backend Admin que envia y valida el OTP del CRM (sin secretos).
NEXT_PUBLIC_ADMIN_API_URL=https://api.undercodeec.com

# Integración servidor a servidor para referencias publicitarias de WhatsApp.
HERMES_API_URL=http://localhost:3003/api
HERMES_ATTRIBUTION_KEY=replace-with-the-same-32-byte-key-configured-in-hermes
ATTRIBUTION_ALLOWED_ORIGINS=http://localhost:3000,https://undercodeec.com
ATTRIBUTION_REQUEST_TIMEOUT_MS=2500
NEXT_PUBLIC_CONSENT_POLICY_VERSION=2026-09-17
