# OTP sin contrasena para Hermes CRM. Genera valores aleatorios de al menos 32 bytes.
CRM_OTP_HASH_SECRET=replace-with-a-random-32-byte-secret
CRM_HERMES_PROOF_SECRET=replace-with-the-same-random-32-byte-secret-configured-in-hermes

# Opcionales: valores seguros por defecto (10 min, 60 s, 5 intentos).
CRM_OTP_TTL_MS=600000
CRM_OTP_COOLDOWN_MS=60000
CRM_OTP_MAX_ATTEMPTS=5
CRM_OTP_IP_MAX_REQUESTS=5

# Base de datos local MySQL/MariaDB. Usa una cuenta de aplicación autenticada
# por contraseña; mysql2 no puede usar el plugin GSSAPI de MariaDB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=undercodeec
DB_USER=undercodeec_app
DB_PASSWORD=replace-with-the-application-password

# País para precargar formularios cuando no haya cabecera GeoIP ni detección del
# navegador. No configures la ubicación de la VPS como si fuera la del visitante.
DEFAULT_VISITOR_COUNTRY=EC

# Actívalo solo si Nginx u otro proxy borra X-Geo-Country enviado por clientes y
# añade un valor GeoIP propio y confiable antes de reenviar la petición.
TRUST_PROXY_GEO_HEADERS=false

# ReCAPTCHA Enterprise para formularios y transferencias. La API key es secreta;
# la SITE_KEY se comparte de forma controlada mediante /api/public-config.
RECAPTCHA_PROJECT_ID=your-google-cloud-project-id
RECAPTCHA_API_KEY=your-recaptcha-enterprise-api-key
RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key
RECAPTCHA_MIN_SCORE=0.5

# URL pública del backend; se usa al devolver la URL del comprobante cargado.
PUBLIC_API_URL=https://api.undercodeec.com
