# API Express principal
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001

# Proxy Hermes del mismo origen. HERMES_API_URL solo se usa en el servidor Next.js.
NEXT_PUBLIC_HERMES_API_URL=/api/hermes
HERMES_API_URL=http://localhost:3003/api

# Chat y servicios públicos
NEXT_PUBLIC_CHAT_IDLE_TIMEOUT_MS=1800000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/replace-me/exec

# Supabase del frontend (claves publicables, nunca service-role)
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace-with-publishable-key
