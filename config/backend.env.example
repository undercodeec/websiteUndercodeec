NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=undercodeec
DB_USER=undercodeec
DB_PASSWORD=replace-with-database-password

# Administración y sesiones
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
CHAT_AUTH_SECRET=replace-with-at-least-32-random-bytes
CHAT_AUTH_COOKIE_NAME=undercodeec_chat_auth
CHAT_AUTH_COOKIE_DOMAIN=
CHAT_AUTH_TOKEN_TTL_SECONDS=2592000
CHAT_AUTH_IDLE_TIMEOUT_MS=1800000

# OTP del CRM Hermes
CRM_OTP_HASH_SECRET=replace-with-at-least-32-random-bytes
CRM_HERMES_PROOF_SECRET=replace-with-the-same-secret-configured-in-hermes
CRM_OTP_TTL_MS=600000
CRM_OTP_COOLDOWN_MS=60000
CRM_OTP_MAX_ATTEMPTS=5
CRM_OTP_IP_MAX_REQUESTS=5
CRM_OTP_LOCK_MS=900000

# PayPhone
PAYPHONE_TOKEN=replace-with-payphone-token
PAYPHONE_STORE_ID=replace-with-payphone-store-id

# Correo SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-with-smtp-user
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_BUSINESS=ventas@example.com

# IA, TTS y límites
GEMINI_API_KEY=replace-with-gemini-key
GOOGLE_TTS_API_KEY=replace-with-google-tts-key
CHAT_IA_BURST_MAX=2

# reCAPTCHA Enterprise
RECAPTCHA_PROJECT_ID=replace-with-project-id
RECAPTCHA_API_KEY=replace-with-api-key
RECAPTCHA_SITE_KEY=replace-with-site-key
RECAPTCHA_MIN_SCORE=0.5

# Supabase usado por el backend
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_KEY=replace-with-server-key

# Facturación SRI: operación futura. No habilitar producción hasta certificar en celcer.
# SRI_AMBIENTE=1
# SRI_RUC=
# SRI_RAZON_SOCIAL=
# SRI_NOMBRE_COMERCIAL=
# SRI_DIR_MATRIZ=
# SRI_ESTAB=001
# SRI_PTO_EMI=001
# SRI_SECUENCIAL_INICIO=1
# SRI_OBLIGADO_CONTABILIDAD=NO
# SRI_CONTRIBUYENTE_RIMPE=false
