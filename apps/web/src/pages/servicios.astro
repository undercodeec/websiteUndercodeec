---
import PrimaryFooter from "../components/global/PrimaryFooter.astro";
import { productStories, services, testimonials } from "../content/services";
import "../styles/pages/services.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Servicios digitales: software, aplicaciones, diseño web y marketing para hacer crecer tu negocio." />
    <title>Servicios | Undercodeec</title>
  </head>
  <body>
    <header class="services-header">
      <a class="services-header__brand" href="/" aria-label="Undercodeec, inicio">UNDERCODEEC.</a>
      <nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/servicios" aria-current="page">Servicios</a><a class="services-header__cta" href="/#reserva_agenda">Agendar reunión <span>→</span></a></nav>
    </header>

    <main>
      <section class="services-hero" aria-labelledby="services-title">
        <p>Servicios digitales <span>01</span></p>
        <h1 id="services-title">Soluciones para<br />hacer crecer<br />tu negocio.</h1>
      </section>

      <section class="services-grid" aria-label="Servicios disponibles">
        {services.map(([number, title, description]) => (
          <article class="services-grid__card">
            <span>{number}</span>
            <h2>{title}</h2>
            <p>{description}</p>
          </article>
        ))}
      </section>

      <section class="services-intro" aria-labelledby="products-title">
        <p>Lo que construimos <span>02 / 04</span></p>
        <h2 id="products-title">Productos digitales pensados para avanzar.</h2>
      </section>

      <section class="service-stories" aria-label="Áreas de desarrollo">
        {productStories.map(([number, category, title, description], index) => (
          <article class:list={["service-story", { "service-story--reverse": index % 2 === 1 }]}>
            <div class="service-story__meta"><span>{number}</span><span>{category}</span></div>
            <div class="service-story__visual" aria-hidden="true"><i>+</i><i>+</i><i>+</i><i>+</i></div>
            <div class="service-story__content">
              <h2>{title}</h2>
              <p>{description}</p>
              <details open><summary>Seguridad, diseño y escalabilidad <span>+</span></summary><p>Definimos cada solución según los objetivos y los procesos reales de tu equipo.</p></details>
              <a href="/contacto">Conocer más <span>→</span></a>
            </div>
          </article>
        ))}
      </section>

      <section class="services-testimonials" aria-labelledby="reviews-title">
        <p>Reseñas de empresas</p>
        <h2 id="reviews-title">La confianza se construye en cada entrega.</h2>
        <div>
          {testimonials.map(([company, quote]) => <blockquote><p>“{quote}”</p><cite>{company}</cite></blockquote>)}
        </div>
      </section>
    </main>

    <PrimaryFooter />
  </body>
</html>
